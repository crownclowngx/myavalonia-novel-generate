<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NovelGeneratePlugin.Features.ModelConnections" x:Class="NovelGeneratePlugin.Features.ModelConnections.ModelConnectionsView" x:DataType="local:ModelConnectionsTool">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="8">
      <TextBlock Text="模型连接" FontSize="24" FontWeight="SemiBold" />
      <WrapPanel>
        <Button Content="新连接" Command="{Binding NewConnectionCommand}" Margin="0,0,6,6" />
        <Button Content="保存配置" Command="{Binding SaveConfigurationCommand}" Margin="0,0,6,6" />
        <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
        <Button Content="放弃未保存更改" Command="{Binding ResetConfigurationCommand}" Margin="0,0,6,6" />
      </WrapPanel>
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="10">
        <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" IsEnabled="{Binding CanNavigate}" HorizontalAlignment="Stretch" />
        <StackPanel Spacing="8" IsEnabled="{Binding CanManage}">
          <TextBox x:Name="ConnectionNameEditor" Text="{Binding Name}" MaxLength="120" PlaceholderText="连接名称" />
          <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" HorizontalAlignment="Stretch" />
          <TextBox Text="{Binding Endpoint}" IsVisible="{Binding IsApi}" PlaceholderText="HTTPS API 地址，例如 https://api.deepseek.com" />
          <TextBox Text="{Binding CodexExecutable}" IsVisible="{Binding !IsApi}" PlaceholderText="已登录的 Codex CLI 完整 exe 路径" />
          <TextBlock Text="分别配置规划、正文与检查模型；API 的当前模型名称请按服务商文档填写。" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:PresetEditor">
                <StackPanel Spacing="6" Margin="0,0,0,12">
                  <TextBlock Text="{Binding Purpose}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Model}" PlaceholderText="模型 ID" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Text="输出上限" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding MaxOutputTokens}" Minimum="256" Maximum="131072" Increment="256" />
                    <TextBlock Grid.Column="2" Text="推理强度" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Text="{Binding ReasoningEffort}" PlaceholderText="low / medium / high" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding DefaultStatus}" TextWrapping="Wrap" />
        <WrapPanel>
          <Button Content="设为新书默认" Command="{Binding MakeDefaultCommand}" Margin="0,0,6,6" />
          <Button Content="清除新书默认" Command="{Binding ClearDefaultCommand}" />
        </WrapPanel>
        <WrapPanel>
          <Button Content="生成一句检测（消耗额度）" Command="{Binding ProbeCommand}" Margin="0,0,6,6" />
          <Button Content="取消检测" Command="{Binding CancelProbeCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding ProbeResult}" TextWrapping="Wrap" />
        <TextBlock Text="本连接最近 20 条请求（可重开查看候选）" />
        <ComboBox ItemsSource="{Binding RecentRequests}" SelectedItem="{Binding SelectedRequest}" IsEnabled="{Binding CanManage}" HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding CredentialStatus}" TextWrapping="Wrap" />
        <StackPanel Spacing="8" IsVisible="{Binding IsApi}" IsEnabled="{Binding CanManage}">
          <TextBox x:Name="SecretEditor" Text="{Binding SecretInput}" PasswordChar="●" MaxLength="8192" PlaceholderText="输入新 API Key（不回显已有密钥）" />
          <CheckBox Content="使用 Windows 当前用户加密保存；不勾选则仅本次会话" IsChecked="{Binding PersistSecret}" />
          <WrapPanel>
            <Button Content="保存密钥" Command="{Binding SaveSecretCommand}" Margin="0,0,6,6" />
            <Button Content="清除已保存密钥" Command="{Binding ClearSecretCommand}" Margin="0,0,6,6" />
            <Button Content="清空输入" Command="{Binding ClearInputCommand}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
  </Grid>
</UserControl>
